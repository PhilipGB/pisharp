{
  "schema": 1,
  "capability": "settings-branchsummary-skipprompt",
  "piSha": "b06c1f2cf1dea6af8748ddeee18c23587d2cb7c6",
  "default": false,
  "schemaContract": {
    "description": "When true, skips the \"Summarize branch?\" prompt and defaults to no summary.",
    "getter": "this.settings.branchSummary?.skipPrompt ?? SETTINGS_DEFAULTS.branchSummary.skipPrompt",
    "promptGate": "if (!this.settingsManager.getBranchSummarySkipPrompt()) { show \"Summarize branch?\" }",
    "navigation": "navigateTree(entryId, { summarize: false }) when the prompt is skipped"
  },
  "sources": [
    {
      "file": "packages/coding-agent/src/core/settings-defaults.ts",
      "lines": "14-17",
      "symbol": "SETTINGS_DEFAULTS.branchSummary",
      "observation": "reserveTokens is 16384 and skipPrompt is false."
    },
    {
      "file": "packages/coding-agent/src/core/settings-schema.ts",
      "lines": "31-42",
      "symbol": "BranchSummarySettingsSchema",
      "observation": "skipPrompt is an optional boolean described as skipping the 'Summarize branch?' prompt and defaulting to no summary."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "58-82",
      "symbol": "isMergeableObject/deepMergeObjects",
      "observation": "Scopes merge by property presence; only undefined is skipped, arrays and other non-objects are not mergeable and replace the lower value."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "366-409",
      "symbol": "loadFromStorage/tryLoadFromStorage",
      "observation": "Settings files are JSON.parse'd and migrated only; stored values are never validated against the schema, so malformed shapes load."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "425-450",
      "symbol": "deepMergeSettings",
      "observation": "The effective settings are the user settings deep-merged with the trusted project settings; an untrusted project contributes {}."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "882-891",
      "symbol": "getBranchSummarySettings/getBranchSummarySkipPrompt",
      "observation": "Both getters return the merged value unless it is nullish, so a stored string, number, object or array is returned unchanged."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/interactive-mode.ts",
      "lines": "5602-5622",
      "symbol": "showTreeSelector summarization gate",
      "observation": "The summary selector is skipped when the getter is falsey; wantsSummary stays false and navigateTree receives summarize: false."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/settings-selector.ts",
      "lines": "485-700",
      "symbol": "main settings items",
      "observation": "No branchSummary.skipPrompt row exists: `grep -n skipPrompt` finds nothing in the settings selector, so the setting is file-only."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "629-651",
      "symbol": "save/persistScopedSettings",
      "observation": "Writes only enqueue the global scope, so a file-authored skipPrompt entry is never rewritten by the tree or summarization flows."
    }
  ],
