      "required": false,
      "observation": "PiSharp renders '<id> \u00b7 <preview> \u00b7 Message n of m' where pinned Pi renders the preview and metadata on separate lines.",
      "projection": "The checkpoint projection compares message count, selected index and selected preview text, not the row layout."
    },
    {
      "id": "settings-journey-mode",
      "required": false,
      "observation": "The pinned settings journey runs in regular mode because a long fullscreen settings session overflows the emulator snapshot for both products.",
      "projection": "The row, description, value order, live application and persistence are mode-independent; PiSharp's own /settings is covered by its PTY test."
    }
