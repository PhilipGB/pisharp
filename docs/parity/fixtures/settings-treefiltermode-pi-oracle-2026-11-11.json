  "default": "default",
  "label": "Tree filter mode",
  "description": "Default filter when opening /tree",
  "sources": [
    {
      "file": "packages/coding-agent/src/core/settings-defaults.ts",
      "lines": "46",
      "symbol": "SETTINGS_DEFAULTS.treeFilterMode",
      "observation": "The shared runtime default is the string 'default'."
    },
    {
      "file": "packages/coding-agent/src/core/settings-schema.ts",
      "lines": "345-357",
      "symbol": "treeFilterMode",
      "observation": "Optional union of default, no-tools, user-only, labeled-only and all, described as 'Default filter when opening /tree', defaulted from SETTINGS_DEFAULTS."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "1366-1375",
      "symbol": "getTreeFilterMode/setTreeFilterMode",
      "observation": "The getter reads the merged settings and returns the default unless the stored value is one of the five literals; the setter writes global settings and saves."
    },
    {
      "file": "packages/coding-agent/src/core/settings-manager.ts",
      "lines": "377-408",
      "symbol": "loadFromStorage/tryLoadFromStorage",
      "observation": "Settings files are JSON.parse'd and migrated only; values are never validated against the schema, so an unrecognized value loads and resolves to the default."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/settings-selector.ts",
      "lines": "596-601",
      "symbol": "tree-filter-mode item",
      "observation": "Label 'Tree filter mode', description 'Default filter when opening /tree', currentValue from config and values in pinned order."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/settings-selector.ts",
      "lines": "955-958",
      "symbol": "onTreeFilterModeChange",
      "observation": "A chosen value is forwarded to the interactive-mode callback."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/interactive-mode.ts",
      "lines": "5080-5082",
      "symbol": "onTreeFilterModeChange",
      "observation": "The callback persists the choice through settingsManager.setTreeFilterMode."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/interactive-mode.ts",
      "lines": "5575-5579",
      "symbol": "showTreeSelector",
      "observation": "Every /tree open reads getTreeFilterMode and passes initialFilterMode to the selector; /tree, app.session.tree, configured double-Escape and the summary-cancel reopen share it."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/tree-selector.ts",
      "lines": "129-142",
      "symbol": "TreeList constructor",
      "observation": "filterMode is seeded from initialFilterMode before applyFilter runs, so the first render is already filtered."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/tree-selector.ts",
      "lines": "331-420",
      "symbol": "TreeList.applyFilter",
      "observation": "default hides label/context_edit/custom/model_change/thinking_level_change/session_info; no-tools adds toolResult removal; user-only keeps user messages; labeled-only keeps labelled nodes; all keeps everything except usage entries and text-free assistant messages that are not the current leaf."
    },
    {
      "file": "packages/coding-agent/src/modes/interactive/components/tree-selector.ts",
      "lines": "648-664",
      "symbol": "TreeList.getStatusLabels",
      "observation": "Non-default filters append ' [no-tools]', ' [user]', ' [labeled]' or ' [all]'; default appends nothing."
    },
    {
      "file": "packages/tui/src/components/settings-list.ts",
      "lines": "284-288",
      "symbol": "SettingsList value cycling",
      "observation": "Enter/Space cycles a value item through its values array in order and reports the new value; there is no reset-to-unset entry."
    }
  ],
