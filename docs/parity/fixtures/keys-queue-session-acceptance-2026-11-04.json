  "findings": [
    {
      "id": "full-render-differences",
      "required": false,
      "status": "documented",
      "detail": "Paired full render streams differ in paint/repaint timing and transient Working spinner glyphs; named semantic checkpoints and provider requests match."
    },
    {
      "id": "fuzzy-row-order",
      "required": false,
      "status": "documented",
      "detail": "Search queries that fuzzily match the shared cwd can order non-selected rows differently; selected session validity and composition are covered by deterministic tests."
    },
    {
      "id": "selection-after-mutation",
      "required": false,
      "status": "documented",
      "detail": "Pinned Pi resets or clamps picker selection after rename/delete; PiSharp resets to the first row in the PTY path and preserves the selected key on sort/filter toggles."
    },
    {
      "id": "status-auto-hide",
      "required": false,
      "status": "documented",
      "detail": "Pinned Pi auto-hides picker status messages after a timeout while PiSharp keeps them until the next action; status text is covered by deterministic tests rather than semantic checkpoints."
    },
    {
      "id": "windows-wsl-pty",
      "required": false,
      "status": "documented",
      "detail": "Windows/WSL Ctrl+Q and Alt+Q defaults are covered by deterministic keymap replay; the PTY differential runs on Linux."
    },
    {
      "id": "system-prompt-history",
      "required": false,
      "status": "documented",
      "detail": "Provider request facts compare user/assistant/tool turns exactly; the generated system prompt remains pinned-Pi-owned text outside this capability."
    },
    {
      "id": "threaded-tree-grouping",
      "required": false,
      "status": "documented",
      "detail": "PiSharp Threaded mode is a flat activity-ordered list; pinned Pi also groups child sessions by parentSessionPath with tree prefixes. Parent lineage and tree grouping remain in keys-tree-scoped-picker. The queue/session fixture creates root sessions only."
    },
    {
      "id": "all-scope-scan-progress",
      "required": false,
      "status": "documented",
      "detail": "The first Tab loads all-project stores synchronously before the overlay repaints; pinned Pi streams Loading x/y progress and partial results. This is scale-dependent and deferred while current/all scope, sorting and filtering semantics are verified."
    }
  ]
