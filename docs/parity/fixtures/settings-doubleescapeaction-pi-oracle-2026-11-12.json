    {
      "file": "packages/coding-agent/src/modes/interactive/interactive-mode.ts",
      "lines": "3070-3096",
      "symbol": "defaultEditor.onEscape",
      "observation": "Streaming, running bash, bash-entry mode and a non-empty editor all take precedence; 'none' skips the timer; otherwise a second press strictly less than 500 ms after the first fires and resets the timer, and any other press records its own time."
