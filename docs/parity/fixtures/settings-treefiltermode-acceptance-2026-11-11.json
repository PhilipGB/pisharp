  "findings": [
    {
      "id": "F1",
      "required": false,
      "status": "declared",
      "note": "PiSharp renders the tree and settings overlays inside its own bordered panel with its own key-hint wording; panel content and settings semantics are compared instead of the surrounding chrome, as in keys-tree-scoped-picker."
    },
    {
      "id": "F2",
      "required": false,
      "status": "declared",
      "note": "PiSharp appends its standard inherit/reset row to enum settings and supports Delete-reset; pinned Pi only cycles values. Effective default/reset behaviour matches."
    },
    {
      "id": "F3",
      "required": false,
      "status": "declared",
      "note": "PiSharp-only bookkeeping entry types stay hidden in every filter; pinned Pi has no equivalent entries."
