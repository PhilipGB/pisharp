  "findings": [
    {
      "id": "tree-selector-visual-style",
      "required": false,
      "classification": "non-required visual difference",
      "detail": "Pi renders the double-Escape tree selector as an unboxed Session Tree list; PiSharp renders a boxed Conversation tree list with its retained tool_loadout/tool_transcript entries. Trigger, empty-editor gating, 500 ms window, active-session retention and dismissal handoff are verified; complete tree-selector parity remains out of scope."
    },
    {
      "id": "transient-render-and-footer-differences",
      "required": false,
      "classification": "non-required visual difference",
      "detail": "Full render streams retain transient loader frames, footer colors and normal-screen cursor rows that differ. Fixture-selected checkpoint editor text, logical cursor and lifecycle effects match; full raw-byte and full-render equality is not claimed."
    },
    {
      "id": "windows-job-control",
      "required": false,
      "classification": "platform limitation",
      "detail": "Unix job control is not claimed on Windows. PiSharp reports the pinned-Pi unsupported-action message and has no default app.suspend binding on Windows."
    }
  ]
}
