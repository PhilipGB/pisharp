		/// When <see langword="true" />, compaction is disabled regardless of <see cref="P:Microsoft.Agents.AI.HarnessAgentOptions.CompactionStrategy" />,
		/// <see cref="P:Microsoft.Agents.AI.HarnessAgentOptions.MaxContextWindowTokens" />, or <see cref="P:Microsoft.Agents.AI.HarnessAgentOptions.MaxOutputTokens" /> settings. No
		/// <see cref="T:Microsoft.Agents.AI.Compaction.CompactionProvider" /> is added to the chat client pipeline, and the default
		/// <see cref="T:Microsoft.Agents.AI.InMemoryChatHistoryProvider" /> is configured without a chat reducer.
