<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.7" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.16" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.15" />
    <PackageReference Include="AWSSDK.Signin" Version="4.0.101.11" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tui\Themes\*.json" LogicalName="PiSharp.Cli.Tui.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Providers\Data\image-models.json" LogicalName="PiSharp.Cli.Providers.Data.image-models.json" />
    <EmbeddedResource Include="Providers\Data\classifier-models.json" LogicalName="PiSharp.Cli.Providers.Data.classifier-models.json" />
    <EmbeddedResource Include="Providers\Data\mistral-models.json" LogicalName="PiSharp.Cli.Providers.Data.mistral-models.json" />
    <EmbeddedResource Include="Providers\Data\azure-openai-responses-models.json" LogicalName="PiSharp.Cli.Providers.Data.azure-openai-responses-models.json" />
    <EmbeddedResource Include="Providers\Data\openai-codex-responses-models.json" LogicalName="PiSharp.Cli.Providers.Data.openai-codex-responses-models.json" />
    <EmbeddedResource Include="Providers\Data\google-generative-ai-models.json" LogicalName="PiSharp.Cli.Providers.Data.google-generative-ai-models.json" />
    <EmbeddedResource Include="Providers\Data\google-vertex-models.json" LogicalName="PiSharp.Cli.Providers.Data.google-vertex-models.json" />
    <EmbeddedResource Include="Providers\Data\amazon-bedrock-models.json" LogicalName="PiSharp.Cli.Providers.Data.amazon-bedrock-models.json" />
    <EmbeddedResource Include="Providers\Data\radius-models.json" LogicalName="PiSharp.Cli.Providers.Data.radius-models.json" />
    <EmbeddedResource Include="Providers\Data\huggingface-models.json" LogicalName="PiSharp.Cli.Providers.Data.huggingface-models.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiSharp.Runtime\PiSharp.Runtime.csproj" />
    <InternalsVisibleTo Include="PiSharp.Tests" />
  </ItemGroup>

</Project>
