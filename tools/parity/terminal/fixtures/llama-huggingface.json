{
  "id": "llama-huggingface",
  "mockHuggingFace": true,
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools", "--no-approve", "--no-context-files"
    ]
  },
  "settings": { "quietStartup": true },
  "concurrentHttpGroups": [
    {
      "occurrence": 1,
      "requests": [
        { "method": "GET", "path": "/models/sse" },
        { "method": "POST", "path": "/models" }
      ]
    }
  ],
  "environment": {
    "pi": {
      "LLAMA_BASE_URL": "{router}",
      "HF_TOKEN": "fixture-hf-token",
      "PI_PARITY_HF_BASE_URL": "{router}"
    },
    "pisharp": {
      "LLAMA_BASE_URL": "{router}",
      "HF_TOKEN": "fixture-hf-token",
      "HF_ENDPOINT": "{router}"
    }
  },
  "llamaModels": [
    {
      "id": "loaded-fixture-model",
      "status": { "value": "loaded", "args": ["--ctx-size", "8192"] },
      "architecture": { "input_modalities": ["text"], "output_modalities": ["text"] },
      "source": "filesystem",
      "meta": { "n_ctx": 8192 }
    }
  ],
  "llamaProps": { "models_autoload": false, "chat_template": "fixture" },
  "llamaBehavior": {
    "catalogSuccessRequestGate": "catalog-requested",
    "catalogSuccessResponseGate": "catalog-response",
    "downloadRequestGate": "download-request",
    "downloadResponseGate": "download-response",
    "downloadDelaySeconds": 1.5,
    "downloadProgressDelaySeconds": 0.5,
    "downloadProgressGate": "download-progress",
    "downloadFinishGate": "download-finished",
    "downloadPollGate": "download-poll"
  },
  "huggingFace": {
    "detailsDelaySeconds": 0.5,
    "searchResults": [
      { "id": "owner/Qwen2.5-Coder-GGUF", "downloads": 2500000 },
      { "id": "owner/Qwen-Coder-GGUF", "downloads": 2200000 }
    ],
    "details": {
      "owner/Qwen2.5-Coder-GGUF": {
        "id": "owner/Qwen2.5-Coder-GGUF",
        "gated": "manual",
        "siblings": [
          { "rfilename": "model-Q4_K_M.gguf", "size": 2147483648 },
          { "rfilename": "model-Q5_K_M.gguf", "size": 3221225472 },
          { "rfilename": "mmproj-F16.gguf", "size": 1048576 }
        ]
      }
    }
  },
  "dimensions": [{ "columns": 100, "rows": 32 }],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "actions": [
    { "id": "startup", "expect": "fixture-model" },
    { "id": "open-manager", "send": "/llama\r", "waitGatesAfter": ["catalog-requested"], "expect": "Loading…", "quietMs": 0 },
    { "id": "release-manager-catalog", "releaseGates": ["catalog-response"], "expect": "loaded-fixture-model" },
    { "id": "select-download-option", "send": "\u001b[B", "expect": "Download model…" },
    { "id": "open-download", "send": "\r", "expect": "Model name or owner/repository[:quant]" },
    { "id": "search-model", "send": "qwen2", "expect": "owner/Qwen2.5-Coder-GGUF" },
    { "id": "cancel-search", "send": "\u001b", "expect": "llama.cpp models" },
    { "id": "select-cached-download-option", "send": "\u001b[B", "expect": "Download model…" },
    { "id": "open-download-cached", "send": "\r", "expect": "Model name or owner/repository[:quant]" },
    { "id": "cached-search-results", "send": "qwen2", "expect": "owner/Qwen2.5-Coder-GGUF" },
    { "id": "select-model", "send": "\r", "expect": "Hugging Face access required", "allowStaticFrame": true },
    { "id": "accept-gate", "expect": "Hugging Face access required", "allowStaticFrame": true },
    { "id": "confirm-gate", "send": "\r", "expect": "Select quantization" },
    { "id": "select-quantization", "send": "\r", "waitGatesAfter": ["download-request"], "expect": "Starting…", "quietMs": 0 },
    { "id": "start-download", "releaseGates": ["download-response"],
      "waitForModelPoll": "owner/Qwen2.5-Coder-GGUF:Q4_K_M", "expect": "Downloading model", "notExpect": "Starting…", "quietMs": 0 },
    { "id": "wait-download-progress", "releaseGates": ["download-progress"], "expect": "50%" },
    { "id": "download-finished", "releaseGates": ["download-finished"], "expect": "Downloaded owner/Qwen2.5-Coder-GGUF:Q4_K_M", "timeout": 15 },
    { "id": "close-manager", "send": "\u001b", "expect": "fixture-model" }
  ],
  "terminal": { "keyboardProtocol": "kitty" }
}
