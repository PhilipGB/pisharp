{
  "id": "resource-skill-prompt-bash",
  "workingDirectory": "resource-project",
  "settings": {
    "quietStartup": true,
    "skills": [
      "custom-skills"
    ]
  },
  "environment": {
    "pi": {
      "HOME": "{agent}/isolated-home"
    },
    "pisharp": {
      "HOME": "{agent}/isolated-home"
    }
  },
  "arguments": {
    "pi": [
      "--provider",
      "fixture",
      "--model",
      "fixture-model",
      "--no-session",
      "--offline",
      "--no-extensions",
      "--no-prompt-templates",
      "--skill",
      "temporary-skills",
      "--approve",
      "--tools",
      "bash"
    ],
    "pisharp": [
      "--provider",
      "fixture",
      "--model",
      "fixture-model",
      "--no-session",
      "--offline",
      "--no-extensions",
      "--no-prompt-templates",
      "--no-context-files",
      "--skill",
      "temporary-skills",
      "--approve",
      "--tools",
      "bash"
    ]
  },
  "projectFiles": {
    "resource-project/.pi/settings.json": "{\"skills\":[\"custom-skills\"]}",
    "resource-project/.pi/custom-skills/project-only/SKILL.md": "---\nname: project-only\ndescription: Project-only skill\n---\nPROJECT-ONLY-BODY",
    "resource-project/.pi/custom-skills/shared/SKILL.md": "---\nname: shared\ndescription: project shared skill\n---\nPROJECT-SHARED-BODY",
    "resource-project/temporary-skills/temp-only/SKILL.md": "---\nname: temp-only\ndescription: Temporary-only skill\n---\nTEMP-ONLY-BODY",
    "resource-project/temporary-skills/shared/SKILL.md": "---\nname: shared\ndescription: temporary shared skill\n---\nTEMPORARY-SHARED-BODY",
    "resource-project/temporary-skills/unsafe&skill/SKILL.md": "---\nname: unsafe&skill\ndescription: Unsafe <skill> & description\n---\nUNSAFE-BODY"
  },
  "files": {
    "pi": {
      "custom-skills/user-only/SKILL.md": "---\nname: user-only\ndescription: User-only skill\n---\nUSER-ONLY-BODY",
      "custom-skills/shared/SKILL.md": "---\nname: shared\ndescription: user shared skill\n---\nUSER-SHARED-BODY",
      "trust.json": {
        "/tmp/pisharp-terminal-fixture-workspace/resource-project": true
      }
    },
    "pisharp": {
      "custom-skills/user-only/SKILL.md": "---\nname: user-only\ndescription: User-only skill\n---\nUSER-ONLY-BODY",
      "custom-skills/shared/SKILL.md": "---\nname: shared\ndescription: user shared skill\n---\nUSER-SHARED-BODY",
      "trust.json": {
        "/tmp/pisharp-terminal-fixture-workspace/resource-project": true
      }
    }
  },
  "workspaceFiles": {},
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "loaded-resource-slash-commands",
      "send": "/skill:",
      "expect": "unsafe&skill"
    },
    {
      "id": "clear-completion-draft",
      "send": "\u0003",
      "expect": "fixture-model"
    },
    {
      "id": "invoke-shared-pending",
      "send": "/skill:shared   argument<&> marker   \r",
      "waitGatesAfter": [
        "chat-request-1"
      ],
      "expect": [
        "[skill] shared",
        "argument<&> marker",
        "Working"
      ],
      "notExpect": "/skill:shared",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-shared-content",
      "releaseGates": [
        "chat-content-1"
      ],
      "expect": "fixture reply 1",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-shared-complete",
      "releaseGates": [
        "chat-finish-1"
      ],
      "expect": "fixture reply 1",
      "notExpect": "Working",
      "allowStaticFrame": true
    },
    {
      "id": "invoke-project-only-pending",
      "send": "/skill:project-only   argument<&> marker   \r",
      "waitGatesAfter": [
        "chat-request-2"
      ],
      "expect": [
        "[skill] project-only",
        "argument<&> marker",
        "Working"
      ],
      "notExpect": "/skill:project-only",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-project-only-content",
      "releaseGates": [
        "chat-content-2"
      ],
      "expect": "fixture reply 2",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-project-only-complete",
      "releaseGates": [
        "chat-finish-2"
      ],
      "expect": "fixture reply 2",
      "notExpect": "Working",
      "allowStaticFrame": true
    },
    {
      "id": "invoke-user-only-pending",
      "send": "/skill:user-only   argument<&> marker   \r",
      "waitGatesAfter": [
        "chat-request-3"
      ],
      "expect": [
        "[skill] user-only",
        "argument<&> marker",
        "Working"
      ],
      "notExpect": "/skill:user-only",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-user-only-content",
      "releaseGates": [
        "chat-content-3"
      ],
      "expect": "fixture reply 3",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-user-only-complete",
      "releaseGates": [
        "chat-finish-3"
      ],
      "expect": "fixture reply 3",
      "notExpect": "Working",
      "allowStaticFrame": true
    },
    {
      "id": "invoke-temp-only-pending",
      "send": "/skill:temp-only   argument<&> marker   \r",
      "waitGatesAfter": [
        "chat-request-4"
      ],
      "expect": [
        "[skill] temp-only",
        "argument<&> marker",
        "Working"
      ],
      "notExpect": "/skill:temp-only",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-temp-only-content",
      "releaseGates": [
        "chat-content-4"
      ],
      "expect": "fixture reply 4",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-temp-only-complete",
      "releaseGates": [
        "chat-finish-4"
      ],
      "expect": "fixture reply 4",
      "notExpect": "Working",
      "allowStaticFrame": true
    },
    {
      "id": "invoke-unsafeandskill-pending",
      "send": "/skill:unsafe&skill   argument<&> marker   \r",
      "waitGatesAfter": [
        "chat-request-5"
      ],
      "expect": [
        "[skill] unsafe&skill",
        "argument<&> marker",
        "Working"
      ],
      "notExpect": "/skill:unsafe&skill",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-unsafeandskill-content",
      "releaseGates": [
        "chat-content-5"
      ],
      "expect": "fixture reply 5",
      "quietMs": 0,
      "renderMatch": true
    },
    {
      "id": "invoke-unsafeandskill-complete",
      "releaseGates": [
        "chat-finish-5"
      ],
      "expect": "fixture reply 5",
      "notExpect": "Working",
      "allowStaticFrame": true
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true,
      "expect": null
    }
  ],
  "dimensions": [
    {
      "columns": 120,
      "rows": 40
    }
  ],
  "themes": [
    "dark"
  ],
  "modes": [
    "fullscreen"
  ],
  "terminal": {
    "keyboardProtocol": "kitty"
  },
  "fixtureBehavior": {
    "chatRequestGates": [
      "chat-request-1",
      "chat-request-2",
      "chat-request-3",
      "chat-request-4",
      "chat-request-5"
    ],
    "chatResponseContentGates": [
      "chat-content-1",
      "chat-content-2",
      "chat-content-3",
      "chat-content-4",
      "chat-content-5"
    ],
    "chatResponseFinishGates": [
      "chat-finish-1",
      "chat-finish-2",
      "chat-finish-3",
      "chat-finish-4",
      "chat-finish-5"
    ],
    "chatResponseContentByRequest": [
      "fixture reply 1",
      "fixture reply 2",
      "fixture reply 3",
      "fixture reply 4",
      "fixture reply 5"
    ]
  }
}
