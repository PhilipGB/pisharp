{
  "id": "selectors-settings",
  "settings": {
    "quietStartup": true
  },
  "dimensions": [
    {
      "columns": 80,
      "rows": 24
    },
    {
      "columns": 120,
      "rows": 40
    }
  ],
  "themes": [
    "dark",
    "light"
  ],
  "modes": [
    "fullscreen",
    "regular"
  ],
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "model-picker",
      "send": "/model\r",
      "expect": "fixture-model"
    },
    {
      "id": "close-model-picker",
      "send": "\u001b",
      "expect": "fixture-model"
    },
    {
      "id": "settings",
      "send": "/settings\r",
      "expect": {
        "pi": "Auto-compact",
        "pisharp": "User settings"
      }
    },
    {
      "id": "close-settings",
      "send": "\u001b",
      "expect": "fixture-model"
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true
    }
  ],
  "terminal": {
    "keyboardProtocol": "kitty"
  }
}
