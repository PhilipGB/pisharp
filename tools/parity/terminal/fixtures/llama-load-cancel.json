{
  "id": "llama-load-cancel",
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools", "--no-approve", "--no-context-files"
    ]
  },
  "settings": { "quietStartup": true },
  "concurrentHttpGroups": [
    {
      "occurrence": 1,
      "requests": [
        { "method": "GET", "path": "/models/sse" },
        { "method": "POST", "path": "/models/load" }
      ]
    }
  ],
  "environment": {
    "pi": { "LLAMA_BASE_URL": "{router}" },
    "pisharp": { "LLAMA_BASE_URL": "{router}" }
  },
  "llamaBehavior": {
    "loadDelaySeconds": 1.5,
    "loadProgressDelaySeconds": 0.5,
    "loadRequestGateByModel": { "unloaded-fixture-model": "load-requested" },
    "loadResponseGateByModel": { "unloaded-fixture-model": "load-response" },
    "loadStartGateByModel": { "unloaded-fixture-model": "load-started" },
    "loadProgressGateByModel": { "unloaded-fixture-model": "load-progress" },
    "loadFinishGateByModel": { "unloaded-fixture-model": "load-finished" },
    "loadPollGateByModel": { "unloaded-fixture-model": "load-poll" }
  },
  "llamaModels": [
    {
      "id": "loaded-fixture-model",
      "status": { "value": "loaded", "args": ["--ctx-size", "16384"] },
      "architecture": { "input_modalities": ["text"], "output_modalities": ["text"] },
      "source": "filesystem",
      "meta": { "n_ctx": 16384 }
    },
    {
      "id": "unloaded-fixture-model",
      "status": { "value": "unloaded", "args": ["--ctx-size", "8192"] },
      "architecture": { "input_modalities": ["text"], "output_modalities": ["text"] },
      "source": "preset",
      "meta": { "n_ctx_train": 8192 }
    }
  ],
  "llamaProps": { "models_autoload": false, "chat_template": "fixture" },
  "dimensions": [{ "columns": 100, "rows": 32 }],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "actions": [
    { "id": "startup", "expect": "fixture-model" },
    { "id": "open-manager", "send": "/llama\r", "expect": "llama.cpp models" },
    { "id": "select-unloaded", "send": "\u001b[B\r", "expect": "1 model is loaded" },
    { "id": "keep-loaded-model", "send": "\u001b[B\r", "waitGatesAfter": ["load-requested"], "expect": "Starting…", "quietMs": 0 },
    { "id": "start-load", "releaseGates": ["load-response"], "waitGatesAfter": ["load-started"],
      "waitForModelPoll": "unloaded-fixture-model", "expect": "Loading model", "notExpect": "Starting…", "quietMs": 0 },
    { "id": "wait-load-progress", "releaseGates": ["load-progress"], "expect": "50%" },
    { "id": "cancel-load", "send": "\u001b", "expect": "Stop loading?" },
    { "id": "confirm-cancel", "send": "\r", "expect": "llama.cpp models" },
    { "id": "close-manager", "send": "\u001b", "expect": "fixture-model" }
  ],
  "terminal": { "keyboardProtocol": "kitty" }
}
