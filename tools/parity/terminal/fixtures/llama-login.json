{
  "id": "llama-login",
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools", "--no-approve", "--no-context-files"
    ]
  },
  "settings": { "quietStartup": true },
  "environment": {
    "pi": { "LLAMA_BASE_URL": "{router}/v1", "LLAMA_API_KEY": "initial-environment-key" },
    "pisharp": { "LLAMA_BASE_URL": "{router}/v1", "LLAMA_API_KEY": "initial-environment-key" }
  },
  "actions": [
    { "id": "startup", "expect": "fixture-model" },
    { "id": "url-prompt", "send": "/login llama.cpp\r", "expect": "llama.cpp server URL" },
    { "id": "user-entered-router-root-url", "send": "{router}/v1/", "expect": "/v1/" },
    { "id": "submit-router-root-url", "send": "\r", "expect": "API key (optional)" },
    { "id": "api-key-input", "send": "fixture-secret", "expect": "fixture-secret" },
    { "id": "api-key-submit", "send": "\r", "expect": "Saved API key for llama.cpp" },
    {
      "id": "restart-with-conflicting-environment",
      "restart": true,
      "restartEnvironment": {
        "LLAMA_BASE_URL": "{router}/conflict/v1",
        "LLAMA_API_KEY": "conflicting-environment-key"
      },
      "expect": "fixture-model"
    },
    { "id": "open-manager-after-reload", "send": "/llama\r", "expect": "llama.cpp models" },
    { "id": "close-manager-after-reload", "send": "\u001b", "expect": "fixture-model" }
  ],
  "dimensions": [{ "columns": 100, "rows": 32 }],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "terminal": { "keyboardProtocol": "kitty" }
}
