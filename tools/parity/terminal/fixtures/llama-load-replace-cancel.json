{
  "id": "llama-load-replace-cancel",
  "arguments": {
    "pi": [
      "--provider",
      "fixture",
      "--model",
      "fixture-model",
      "--no-session",
      "--offline",
      "--no-skills",
      "--no-prompt-templates",
      "--no-tools"
    ],
    "pisharp": [
      "--provider",
      "fixture",
      "--model",
      "fixture-model",
      "--no-session",
      "--offline",
      "--no-skills",
      "--no-prompt-templates",
      "--no-tools",
      "--no-approve",
      "--no-context-files"
    ]
  },
  "settings": {
    "quietStartup": true
  },
  "concurrentHttpGroups": [
    {
      "occurrence": 1,
      "requests": [
        { "method": "GET", "path": "/models/sse" },
        { "method": "POST", "path": "/models/load" }
      ]
    },
    {
      "occurrence": 2,
      "requests": [
        { "method": "GET", "path": "/models/sse" },
        { "method": "POST", "path": "/models/load" }
      ]
    },
    {
      "occurrence": 3,
      "requests": [
        { "method": "GET", "path": "/models/sse" },
        { "method": "POST", "path": "/models/load" }
      ]
    }
  ],
  "environment": {
    "pi": {
      "LLAMA_BASE_URL": "{router}"
    },
    "pisharp": {
      "LLAMA_BASE_URL": "{router}"
    }
  },
  "llamaBehavior": {
    "loadProgressDelaySeconds": 0.5,
    "loadProgressGateByModel": {
      "unloaded-fixture-model": "load-progress"
    },
    "loadFinishGateByModel": {
      "unloaded-fixture-model": "load-finished",
      "loaded-fixture-model": "restore-finished"
    },
    "loadPollGateByModel": {
      "unloaded-fixture-model": "load-poll",
      "loaded-fixture-model": "restore-poll"
    },
    "loadStartGateByModel": {
      "unloaded-fixture-model": "load-started",
      "loaded-fixture-model": "restore-started"
    },
    "loadRequestGateByModel": {
      "unloaded-fixture-model": "load-requested",
      "loaded-fixture-model": "restore-requested"
    },
    "loadResponseGateByModel": {
      "unloaded-fixture-model": "load-response",
      "loaded-fixture-model": "restore-response"
    },
    "loadDelaySecondsByModel": {
      "unloaded-fixture-model": 30,
      "loaded-fixture-model": 0
    }
  },
  "llamaModels": [
    {
      "id": "loaded-fixture-model",
      "status": {
        "value": "loaded",
        "args": [
          "--ctx-size",
          "16384"
        ]
      },
      "architecture": {
        "input_modalities": [
          "text"
        ],
        "output_modalities": [
          "text"
        ]
      },
      "source": "filesystem",
      "meta": {
        "n_ctx": 16384
      }
    },
    {
      "id": "unloaded-fixture-model",
      "status": {
        "value": "unloaded",
        "args": [
          "--ctx-size",
          "8192"
        ]
      },
      "architecture": {
        "input_modalities": [
          "text"
        ],
        "output_modalities": [
          "text"
        ]
      },
      "source": "preset",
      "meta": {
        "n_ctx_train": 8192
      }
    }
  ],
  "llamaProps": {
    "models_autoload": false,
    "chat_template": "fixture"
  },
  "dimensions": [
    {
      "columns": 100,
      "rows": 32
    }
  ],
  "themes": [
    "dark"
  ],
  "modes": [
    "fullscreen"
  ],
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "open-manager",
      "send": "/llama\r",
      "expect": "llama.cpp models"
    },
    {
      "id": "select-replacement-target",
      "send": "\u001b[B\r",
      "expect": "1 model is loaded"
    },
    {
      "id": "begin-replacement-load",
      "send": "\r",
      "waitGatesAfter": ["load-requested"],
      "expect": "Starting…",
      "quietMs": 0
    },
    {
      "id": "start-replacement-load",
      "releaseGates": ["load-response"],
      "waitGatesAfter": ["load-started"],
      "expect": "Loading model",
      "notExpect": "Starting…",
      "quietMs": 0
    },
    {
      "id": "wait-load-progress",
      "releaseGates": ["load-progress"],
      "expect": "50%"
    },
    {
      "id": "cancel-replacement-load",
      "send": "\u001b",
      "expect": "Stop loading?"
    },
    {
      "id": "confirm-cancel-and-restore",
      "send": "\r",
      "waitGatesAfter": ["restore-requested"],
      "expect": "Restoring previously loaded models",
      "quietMs": 0
    },
    {
      "id": "start-restoration",
      "releaseGates": ["restore-response"],
      "waitGatesAfter": ["restore-started"],
      "waitForModelPoll": "loaded-fixture-model",
      "expectModelStatus": { "id": "loaded-fixture-model", "value": "loading" },
      "expect": "Restoring previously loaded models",
      "allowStaticFrame": true,
      "quietMs": 0
    },
    {
      "id": "complete-restoration",
      "releaseGates": ["restore-finished"],
      "expect": "llama.cpp models"
    },
    {
      "id": "close-manager",
      "send": "\u001b",
      "expect": "fixture-model"
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true
    }
  ],
  "terminal": {
    "keyboardProtocol": "kitty"
  }
}
