    }
  },
  "dimensions": [
    {
      "columns": 140,
      "rows": 40
    }
  ],
  "themes": [
    "dark"
  ],
  "modes": [
    "fullscreen"
  ],
  "terminal": {
    "keyboardProtocol": "kitty"
  },
  "arguments": {
    "pi": [
      "--session",
      "{agent}/current/current.jsonl",
      "--session-dir",
      "{agent}/sessions",
      "--provider",
      "fixture",
      "--model",
      "fixture-model",
      "--offline",
      "--no-extensions",
      "--no-skills",
      "--no-prompt-templates",
      "--no-tools",
      "--no-context-files"
    ],
    "pisharp": [
      "--session",
      "{agent}/current/current.session.json",
      "--session-dir",
      "{agent}/sessions",
      "--offline",
      "--no-extensions",
      "--no-skills",
      "--no-prompt-templates",
      "--no-tools",
      "--no-context-files",
      "--no-approve"
    ]
  },
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "picker-open",
      "send": "/resume\r",
      "expect": "Resume Session (Current Folder)",
      "timeout": 30
    },
    {
      "id": "picker-tree",
      "expect": [
        "duplicate two",
        "tree child",
        "orphan child"
      ],
      "allowStaticFrame": true,
      "timeout": 15
    },
    {
      "id": "picker-delete-confirm",
      "send": "\u0004",
      "expect": {
        "pi": "Delete session?",
        "pisharp": "Delete duplicate two?"
      }
    },
    {
      "id": "picker-delete-applied",
      "send": "\r",
      "expect": "Session deleted"
    },
    {
      "id": "picker-delete-settled",
      "expect": [
        "duplicate one",
        "tree child"
      ],
      "allowStaticFrame": true,
      "timeout": 15
    },
    {
      "id": "picker-close",
      "send": "\u001b",
      "notExpect": "Resume Session (Current Folder)",
      "timeout": 15
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true
    }
  ],
  "assertionFrames": [
    "startup",
    "picker-open",
    "picker-tree",
    "picker-delete-confirm",
    "picker-delete-applied",
    "picker-delete-settled",
    "quit"
  ]
}
