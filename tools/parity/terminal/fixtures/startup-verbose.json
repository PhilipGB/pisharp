    "fullscreen",
    "regular"
  ],
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true
    }
  ],
  "terminal": {
    "keyboardProtocol": "kitty"
  }
}
