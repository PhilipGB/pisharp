{
  "id": "startup-verbose",
  "settings": {
    "quietStartup": false
  },
  "dimensions": [
    {
      "columns": 80,
      "rows": 24
    },
    {
      "columns": 120,
      "rows": 40
    }
  ],
  "themes": [
    "dark",
    "light"
  ],
