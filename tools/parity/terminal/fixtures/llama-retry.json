{
  "id": "llama-retry",
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools", "--no-approve", "--no-context-files"
    ]
  },
  "settings": { "quietStartup": true },
  "environment": {
    "pi": { "LLAMA_BASE_URL": "{router}" },
    "pisharp": { "LLAMA_BASE_URL": "{router}" }
  },
  "llamaBehavior": {
    "initialModelFailures": 1,
    "catalogFailureRequestGate": "catalog-failure-requested",
    "catalogFailureResponseGate": "catalog-failure-response",
    "catalogSuccessRequestGate": "catalog-retry-requested",
    "catalogSuccessResponseGate": "catalog-retry-response"
  },
  "dimensions": [{ "columns": 100, "rows": 32 }],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "actions": [
    { "id": "startup", "expect": "fixture-model" },
    { "id": "open-manager", "send": "/llama\r",
      "waitGatesAfter": ["catalog-failure-requested"], "expect": "Loading…", "quietMs": 0 },
    { "id": "show-retry", "releaseGates": ["catalog-failure-response"],
      "expect": "llama.cpp unavailable", "quietMs": 0 },
    { "id": "retry-router-waiting", "send": "\r",
      "waitGatesAfter": ["catalog-retry-requested"], "expect": "llama.cpp unavailable",
      "allowStaticFrame": true },
    { "id": "retry-router", "releaseGates": ["catalog-retry-response"],
      "expect": "llama.cpp models" },
    { "id": "close-manager", "send": "\u001b", "expect": "fixture-model" }
  ],
  "terminal": { "keyboardProtocol": "kitty" }
}
