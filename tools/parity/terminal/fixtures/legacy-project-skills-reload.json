{
  "id": "legacy-project-skills-reload",
  "workingDirectory": "legacy-skills-reload-project",
  "settings": {
    "quietStartup": true
  },
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--models", "fixture-model",
      "--no-session", "--offline", "--no-extensions", "--no-prompt-templates",
      "--no-tools", "--no-context-files"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--models", "fixture-model",
      "--no-session", "--offline", "--no-extensions", "--no-prompt-templates",
      "--no-tools", "--no-context-files"
    ]
  },
  "projectFiles": {
    "legacy-skills-reload-project/.pi/settings.json": "{\"skills\":{\"enableSkillCommands\":false,\"customDirectories\":[\"./legacy-skills\"]}}",
    "legacy-skills-reload-project/.pi/legacy-skills/initial-legacy-skill/SKILL.md": "---\nname: initial-legacy-skill\ndescription: Initial legacy skill\n---\nInitial legacy skill body marker.\n"
  },
  "files": {
    "pi": {
      "trust.json": {
        "/tmp/pisharp-terminal-fixture-workspace/legacy-skills-reload-project": true
      }
    },
    "pisharp": {
      "trust.json": {
        "/tmp/pisharp-terminal-fixture-workspace/legacy-skills-reload-project": true
      }
    }
  },
  "actions": [
    {
      "id": "startup",
      "expect": "fixture-model"
    },
    {
      "id": "completion-disabled-before-reload",
      "send": "/skill:",
      "expect": "/skill:"
    },
    {
      "id": "invoke-initial-legacy-skill",
      "send": "initial-legacy-skill first-argument\r",
      "expect": "fixture reply"
    },
    {
      "id": "replace-legacy-skill-settings",
      "writeFiles": {
        "workspace": {
          "legacy-skills-reload-project/.pi/settings.json": {
            "skills": {
              "enableSkillCommands": true,
              "customDirectories": ["./reloaded-skills"]
            }
          },
          "legacy-skills-reload-project/.pi/reloaded-skills/reloaded-legacy-skill/SKILL.md": "---\nname: reloaded-legacy-skill\ndescription: Reloaded legacy skill\n---\nReloaded legacy skill body marker.\n"
        }
      },
      "allowStaticFrame": true
    },
    {
      "id": "reload",
      "send": "/reload\r",
      "expect": {
        "pi": "Reloaded keybindings, extensions, skills, prompts, themes, and context files",
        "pisharp": "Reloaded keybindings, extensions, skills, prompts, themes, and context files"
      }
    },
    {
      "id": "completion-enabled-after-reload",
      "send": "/skill:",
      "expect": "reloaded-legacy-skill"
    },
    {
      "id": "clear-reloaded-skill-completion-probe",
      "send": "\u0003",
      "expect": "fixture-model"
    },
    {
      "id": "invoke-reloaded-legacy-skill",
      "send": "/skill:reloaded-legacy-skill second-argument\r",
      "expect": "fixture reply"
    },
    {
      "id": "quit",
      "send": "/quit\r",
      "exit": true
    }
  ],
  "dimensions": [
    {
      "columns": 120,
      "rows": 40
    }
  ],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "terminal": {
    "keyboardProtocol": "kitty"
  }
}
