{
  "id": "llama-model-picker",
  "arguments": {
    "pi": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools"
    ],
    "pisharp": [
      "--provider", "fixture", "--model", "fixture-model", "--no-session", "--offline",
      "--no-skills", "--no-prompt-templates", "--no-tools", "--no-approve", "--no-context-files"
    ]
  },
  "settings": { "quietStartup": true },
  "environment": {
    "pi": { "LLAMA_BASE_URL": "{router}" },
    "pisharp": { "LLAMA_BASE_URL": "{router}" }
  },
  "llamaModels": [
    {
      "id": "loaded-fixture-model",
      "status": { "value": "loaded", "args": ["--ctx-size", "16384"] },
      "architecture": { "input_modalities": ["text"], "output_modalities": ["text"] },
      "source": "filesystem",
      "meta": { "n_ctx": 16384 }
    },
    {
      "id": "unloaded-fixture-model",
      "status": { "value": "unloaded", "args": ["--ctx-size", "8192"] },
      "architecture": { "input_modalities": ["text"], "output_modalities": ["text"] },
      "source": "preset",
      "meta": { "n_ctx_train": 8192 }
    }
  ],
  "llamaProps": { "models_autoload": false, "chat_template": "fixture" },
  "llamaBehavior": { "loadDelaySeconds": 1.5, "loadProgressDelaySeconds": 0.5 },
  "dimensions": [{ "columns": 100, "rows": 32 }],
  "themes": ["dark"],
  "modes": ["fullscreen"],
  "actions": [
    { "id": "startup", "expect": "fixture-model" },
    { "id": "open-manager", "send": "/llama\r", "expect": "unloaded-fixture-model" },
    { "id": "select-unloaded", "send": "\u001b[B\r", "expect": "1 model is loaded" },
    { "id": "keep-loaded-model", "send": "\u001b[B\r", "expect": "Loading model" },
    { "id": "wait-load-progress", "expect": "50%" },
    { "id": "load-finished", "expect": "unloaded-fixture-model" },
    { "id": "close-manager", "send": "\u001b", "expect": "fixture-model" },
    { "id": "open-model-picker", "send": "/model\r", "expect": { "pi": "Only showing models from configured providers", "pisharp": "Select model" } },
    { "id": "search-new-router-model", "send": "unloaded-fixture-model", "expect": "unloaded-fixture-model [llama.cpp]" },
    { "id": "select-new-router-model", "send": "\r", "expect": { "pi": "Model: unloaded-fixture-model", "pisharp": "Model: llama.cpp/unloaded-fixture-model" } },
    { "id": "quit", "send": "/quit\r", "exit": true }
  ],
  "terminal": { "keyboardProtocol": "kitty" }
}
