[Unit]
Description=PiSharp single-writer implementation controller (opt-in)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/philip/Documents/projects/dotnet/pisharp
Environment=PATH=/home/philip/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/python3 /home/philip/Documents/projects/dotnet/pisharp/tools/autonomy/controller.py --max-dispatches 20
Restart=on-failure
RestartPreventExitStatus=2 3 4
RestartSec=45s
KillMode=control-group
TimeoutStopSec=10s

[Install]
WantedBy=default.target
