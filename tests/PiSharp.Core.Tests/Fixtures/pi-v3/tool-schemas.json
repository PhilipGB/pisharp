  "tools": {
    "read": {"required": ["path"], "optional": ["offset", "limit"]},
    "bash": {"required": ["command"], "optional": []},
    "edit": {"required": ["path", "oldText", "newText"], "optional": []},
    "write": {"required": ["path", "content"], "optional": []},
    "grep": {"required": ["pattern"], "optional": ["path", "glob", "ignoreCase", "literal", "context"]},
    "find": {"required": ["pattern"], "optional": ["path", "limit"]},
    "ls": {"required": ["path"], "optional": []},
    "powershell": {"required": ["command"], "optional": []}
  }
