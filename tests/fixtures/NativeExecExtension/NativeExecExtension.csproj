<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>PiSharp.TestExtensions.NativeExec</PackageId>
    <Version>1.0.0</Version>
    <Description>Compiled extension and deterministic direct-process fixture.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/PiSharp.Extensions.Abstractions/PiSharp.Extensions.Abstractions.csproj" />
    <None Include="$(TargetDir)$(AssemblyName).deps.json"
          Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
    <None Include="$(IntermediateOutputPath)pisharp-extension.json" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <Target Name="GeneratePiSharpExtensionManifest" BeforeTargets="_GetPackageFiles">
    <WriteLinesToFile File="$(IntermediateOutputPath)pisharp-extension.json"
                      Lines="{&quot;id&quot;:&quot;$(PackageId)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;apiVersion&quot;:1,&quot;extensions&quot;:[{&quot;assembly&quot;:&quot;lib/$(TargetFramework)/$(AssemblyName).dll&quot;,&quot;type&quot;:&quot;PiSharp.TestExtensions.NativeExec.ExecExtension&quot;}]}"
                      Overwrite="true" />
  </Target>
</Project>
