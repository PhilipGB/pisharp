<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NativeExtensionApiV8Fixture</AssemblyName>
    <PackageId>PiSharp.TestExtensions.NativeApiV8Fixture</PackageId>
    <Version>1.0.0</Version>
    <Description>Fixture compiled against the PR #8 native extension API contract.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contract/PiSharp.Extensions.Abstractions.V8.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <None Include="../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(TargetDir)$(AssemblyName).deps.json" Pack="true"
          PackagePath="lib/$(TargetFramework)/" Visible="false" />
    <None Include="$(IntermediateOutputPath)pisharp-extension.json" Pack="true"
          PackagePath="/" Visible="false" />
  </ItemGroup>
  <Target Name="GeneratePiSharpExtensionManifest" BeforeTargets="_GetPackageFiles">
    <WriteLinesToFile File="$(IntermediateOutputPath)pisharp-extension.json"
                      Lines="{&quot;id&quot;:&quot;$(PackageId)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;apiVersion&quot;:1,&quot;extensions&quot;:[{&quot;assembly&quot;:&quot;lib/$(TargetFramework)/$(AssemblyName).dll&quot;,&quot;type&quot;:&quot;PiSharp.TestExtensions.NativeApiV8.LegacyExtension&quot;}]}"
                      Overwrite="true" />
  </Target>
</Project>
