<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>PiSharp.TestExtensions.RpcParity</PackageId>
    <Version>1.0.0</Version>
    <Description>Minimal native fixture for RPC parity process tests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/PiSharp.Extensions.Abstractions/PiSharp.Extensions.Abstractions.csproj" />
    <None Include="$(IntermediateOutputPath)pisharp-extension.json" Pack="true"
          PackagePath="/" Visible="false" />
  </ItemGroup>

  <Target Name="GeneratePiSharpExtensionManifest" BeforeTargets="_GetPackageFiles">
    <WriteLinesToFile File="$(IntermediateOutputPath)pisharp-extension.json"
                      Lines="{&quot;id&quot;:&quot;$(PackageId)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;apiVersion&quot;:1,&quot;extensions&quot;:[{&quot;assembly&quot;:&quot;lib/$(TargetFramework)/$(AssemblyName).dll&quot;,&quot;type&quot;:&quot;PiSharp.TestExtensions.RpcParity.RpcParityExtension&quot;}]}"
                      Overwrite="true" />
  </Target>
</Project>
